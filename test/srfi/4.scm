(cond-expand ((not full-numeric-tower) (test-end)))

(test #t (u32vector? (u32vector)))
(test #t (u32vector? (u32vector 0 1 2)))
(test #f (u32vector? #()))
(test #f (u32vector? #(0 1 2)))
(test #f (u32vector? '()))
(test #t (u32vector? (make-u32vector 0)))
(test 0 (u32vector-length (make-u32vector 0)))
(test 1024 (u32vector-length (make-u32vector 1024)))
(test 1024 (u32vector-length (make-u32vector 1024 4294967295)))
(test 3 (u32vector-length (u32vector 0 1 2)))
(test 0 (u32vector-ref (u32vector 0 1 2) 0))
(test 1 (u32vector-ref #u32(0 1 2) 1))
(test 2 (u32vector-ref #u32(0 1 2) 2))
(test (list 0 4294967295 2) (let ((bv (u32vector 0 1 2))) (u32vector-set! bv 1 4294967295) (u32vector->list bv)))
(test '() (u32vector->list (u32vector)))
(test '(0 1 2) (u32vector->list (u32vector 0 1 2)))
(test '(0 1 2) (u32vector->list (u32vector 0 1 2) 0))
(test '(0 1 2) (u32vector->list (u32vector 0 1 2) 0 3))
(test '(1 2) (u32vector->list #u32(0 1 2) 1))
(test '(1) (u32vector->list #u32(0 1 2) 1 2))
(test '() (u32vector->list #u32(0 1 2) 2 2))
(test '() (u32vector->list (list->u32vector '())))
(test '(24 42) (u32vector->list (list->u32vector '(24 42))))

