(test '#u16(1 40 30 20 10) (u16vector-copy vrc1))
(u16vector-reverse-copy! vrc2 1 '#u16(0 10 20 30 40) 1 4)
(test '#u16(1 30 20 10 5) (u16vector-copy vrc2))
(let ((uv (make-u16vector 2 0)))
  (u16vector-set! uv 0 10631)
  (test '#u16(10631 0) uv))

