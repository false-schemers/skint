;;
;; R7RS and Skint tests (OPT_UNICODE)
;; 


(define *tests-run* 0)
(define *tests-passed* 0)

;; variant of good-enough by willc
(define (approx=? x y)
  ;; relative error should be with 0.1%, but greater
  ;; relative error is allowed when the expected value
  ;; is near zero.
  (cond ((infinite? x) (= x (* 2.0 y)))
        ((infinite? y) (= (* 2.0 x) y))
        ((nan? x)      (nan? y))
        ((nan? y)      (nan? x))
        ((> (abs y) 1e-7)
         (< (/ (abs (- x y)) (abs y)) 1e-7))
        (else
         (< (abs (- x y)) 1e-10))))

(define (same? x y)
  (cond ((and (number? x) (inexact? x) (number? y) (inexact? y))
         (and (approx=? (real-part x) (real-part y)) 
              (approx=? (imag-part x) (imag-part y))))
        (else (equal? x y))))

(define-syntax test
  (syntax-rules ()
    ((test name expect expr)
     (test expect expr))
    ((test expect expr)
     (begin
       (set! *tests-run* (+ *tests-run* 1))
       (let ((display-str
              (lambda ()
                (write *tests-run*)
                (display ". ")
                (write 'expr)))
             (res expr))
         (display-str)
         (write-char #\space)
         (display (make-string 10 #\.))
         (cond
          ((same? res expect)
           (set! *tests-passed* (+ *tests-passed* 1))
           (display " [PASS]\n"))
          (else
           (display " [FAIL]\n")
           (display "********** expected ") (write expect)
           (display " but got ") (write res) (newline))))))))


; skip expected failures for now: we can't capture them yet
(define-syntax test-failure
  (syntax-rules ()
    ((test-failure val) 42)))

(define (integer-sqrt/q x)
  (define-values (q r) (exact-integer-sqrt x))
  q)

(define (integer-sqrt/r x)
  (define-values (q r) (exact-integer-sqrt x))
  r)

(define (test-begin . name)
  #f)

(define (test-end)
  (write *tests-passed*)
  (display " out of ")
  (write *tests-run*)
  (display " passed (")
  (write (/ (floor (* (/ *tests-passed* *tests-run*) 10000.)) 100))
  (display "%)")
  (newline)
  (exit (- *tests-run* *tests-passed*)))

